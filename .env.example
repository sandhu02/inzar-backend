# Application Environment
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change_this_to_a_secure_random_string_at_least_32_chars_long

# Database Configuration (Neon or local PostGIS)
# Pooled connection URL (used by the web app with PgBouncer)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/inzar
# Direct connection URL (used by Alembic for DDL / migrations)
DATABASE_URL_DIRECT=postgresql+asyncpg://postgres:postgres@localhost:5432/inzar
# Test database URL (used by pytest)
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/inzar_test

# Database SSL mode (require for Neon, disable for local docker)
DATABASE_SSL=false

# Authentication & Tokens
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_TOKEN_TTL_HOURS=24
GOOGLE_CLIENT_IDS=your-google-client-id.apps.googleusercontent.com

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Cloudinary (Media Uploads)
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz12
CLOUDINARY_UPLOAD_FOLDER=inzar/incidents

# Email Provider ('console' for local development, 'resend' for production)
EMAIL_PROVIDER=console
RESEND_API_KEY=re_placeholder_key
EMAIL_FROM=Inzar Alerts <alerts@inzar.app>

# Push Notification Provider ('log' for local development, 'fcm' for production)
PUSH_PROVIDER=log
FCM_PROJECT_ID=inzar-app
FCM_SERVICE_ACCOUNT_JSON=

# AI Review Provider ('stub' for this build)
REVIEW_PROVIDER=stub

# Rate Limiting (requests per minute / hour per client/IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_SUBMISSION_PER_HOUR=30
RATE_LIMIT_SIGNING_PER_MINUTE=15
RATE_LIMIT_FLAG_PER_MINUTE=20

# Optional Sentry Monitoring
SENTRY_DSN=

